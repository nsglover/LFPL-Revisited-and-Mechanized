openModule /Nat/;
openModule /Division/;
openModule /List/;

File.import "../../../math/load.iml";
File.import "../../core/load-denotational.iml";
File.import "../tuple/load.iml";
File.import "../list/load.iml";

File.loadWithoutDependencies "mem.isto";
openModule /Memory/;

beginModule "NatToMem";



(* REMAINDER *)

(* Hack the typechecker to get it to make use of subptying lemmas in this file *)
val () =
  Constant2Table.insert TypecheckTables.subtypeTactics
  (resolveGlobal /dnat_sem/, resolveGlobal /tp_sem/)
  (Backchain.applyRaw /\Term.Const (resolveGlobal /dnat_sem_sub/)\/);
val () =
  Constant2Table.insert TypecheckTables.subtypeTactics
  (resolveGlobal /dnat_sem/, resolveGlobal /list/)
  (Backchain.applyRaw /\Term.Const (resolveGlobal /dnat_sem_sub/)\/);
val () =
  Constant2Table.insert TypecheckTables.subtypeTactics
  (resolveGlobal /mem_sem/, resolveGlobal /tp_sem/)
  (Backchain.applyRaw /\Term.Const (resolveGlobal /Memory.mem_sem_sub/)\/);


defineInd //
/
  make_remainder : nat -> forall (k : nat) . tp_sem (mem k) of
  | zero . fn k . make_mem 1 k
  | succ r . fn k .
    (
      fnind nat_fn : forall (k : nat) . tp_sem (mem k) of
        | zero . ()
        | succ k . (nil, make_remainder r k)
    ) k
//
  forall (r k : nat) . tp_sem (mem k)
/;


lemma "rotate_remainder"
/
  forall (r k : nat) . r < k ->
  `term_sem _ (arrow _ _) (rotate dnat k) env_nil (() :: nil, make_remainder (succ r) k) =
  make_remainder (succ r) (succ k) : _
/;
inference. intro /r/. induction /r/ >> unfold /rotate/ >> reduce //.
{
  intro /k/.
  destruct /k/ /| k/ >>> [omega, idtac].
  intro /_/. induction /k/ >>> [reflexivity, idtac].
  intro /k ih/. repeatn 2 compat.
  injection /ih/. auto.
}
{
  intro /n ih k k_gt/.
  destruct /k/ /| k/ >>> [omega, idtac].
  so /lt_succ_invert _# 2 k_gt/ /n_lt_k/. clear /k_gt/.
  so /ih k n_lt_k/ /tmp/. clear /ih n_lt_k/. reintro /ih/.
  unfold /rotate/. reduce //. compat. exact /ih/.
}
qed ();


lemma "remainder_to_dnat"
/
  forall (r k : nat) . r <= k ->
  (`term_sem _ (arrow _ _) (mem_to_dnat k) env_nil) (make_remainder r k) = make_dnat (k - r) : _
/;
inference. intro /r/. induction /r/.
{
  intro /k _/. induction /k/ >>> [reflexivity, idtac].
  intro /k ih/. rewrite /-> lappend_correct/.
  rewrite /-> ih/. reflexivity.
}
{
  intro /r ih k h/.
  destruct /k/ /| k/ >>> [omega, idtac].
  reduce //. rewrite /-> ih k __/ >>> [omega, clear /ih/].
  rewrite /-> lappend_correct/. reflexivity.
}
qed ();



(* CONSTANT DIVISION *)

define /mem_div_helper k/
/
  lam
  (
    nrec all_left var
    (pair all_right (nil_mem (succ k)) (nil_mem (succ k)))
    (
      letp (right all_left) var
      (
        llet (left (right all_left))
        (
          letp (left all_right) var
          (app all_right (rotate dnat k) (pair (left (right all_left)) (nsucc (right all_left) var var) var))
        )
        (
          letp (left all_right) var
          (
            nmatch (left all_right) var
            (pair (left all_right) (pair all_right nzero var) var)
            (
              pair all_right (nil_mem (succ k))
              (
                app all_right (mem_append (succ k))
                (
                  pair (left (left (left all_right)))
                  (pair (left (left all_right)) (nsucc (left all_right) var var) var) var
                )
              )
            )
          )
        )
      )
    )
  )
//
  forall (k : nat) . term nil (arrow dnat (tensor (mem (succ k)) (mem (succ k))))
/;
withTypecheck (unfold /mem_div_helper/). qed ();


lemma "mem_div_helper_correct"
/
  forall (n k : nat) .
  let (q, r) = divmod n (succ k) in
  let (mr, mq) = (`term_sem _ (arrow _ _) (mem_div_helper k) env_nil) (make_dnat n) in
  mq = make_mem q (succ k) : tp_sem (mem (succ k)) & mr = make_remainder (succ k - r) (succ k) : tp_sem (mem (succ k))
/;
intro /n k/. inference.
assert /succ k : pos/ /k_pos/ >>> [unfold /pos/ >> splitOf >>> [typecheck, omega], idtac].
rewrite /-> divmod_equal/.
induction /n/.
{
  rewrite /-> div_0 at all, -> mod_0/.
  unfold /mem_div_helper, nrec/.
  reduce //.
  split >>> [autoWith /nil_mem_correct/, clear /k_pos/ >> induction /k/ >> auto].
  
}
{
  intro /n ih/.
  generalize /eq_nat_decide (mod n (succ k)) k/ /_/ /tmp/.
  destruct /tmp/ /r_eq | r_neq/.
  {
    rewrite /-> r_eq in ih, -> minus_succ_l_eq in ih, -> minus_self in ih/. reduce /ih/.
    assert /mod (succ n) (succ k) = 0 : nat/ /h_rem_zero/ >>>
    [
      rewrite /succ n = 1 + n : nat, -> plus_commute, -> mod_plus_alt, -> plus_commute, -> r_eq, -> mod_self/ >>
      reflexivity,
      idtac
    ].
    assert /div (succ n) (succ k) = succ (div n (succ k)) : nat/ /h_div_succ/.
    {
      so /mod_leq_l n (succ k)/ /h_n_k/.
      rewrite /-> r_eq in h_n_k/.
      apply /leq_antisymm/ >>
      (
        (apply /times_cancel_leq_r _# 2 (succ k) __/ >>> [omega, idtac]) >>
        rewrite /-> times_commute (succ (div n (succ k))) _, -> times_dist_succ_r (succ k) _/ >>
        rewrite /-> times_commute (succ k) _, -> div_prop' at all/ >>
        omega
      ).
    }
    rewrite /-> h_div_succ at all, -> h_rem_zero, -> minus_0_r/.
    clear /h_div_succ h_rem_zero r_eq/.
    rewrite /make_remainder (succ k) (succ k) = term_sem (nil_mem (succ k)) env_nil : _/ >>>
    [clear /k_pos n ih mr mq/ >> induction /k/ >> auto, idtac].
    revert /ih/. remember /term_sem _ _ (make_dnat n)/ /_/ /rec_val/ /rec_val_eq/.
    destruct /rec_val/ /mq' mr'/. reduce //.
    intro /(mq'_eq mr'_eq)/.
    unfold /mem_div_helper/. reduce //.
    unfold /mem_div_helper in rec_val_eq/. reduce /rec_val_eq/.
    unfold /nrec, nrec in rec_val_eq/. reduce /concl rec_val_eq/.
    rewrite /<- rec_val_eq/. reduce //. clear /rec_val_eq/.
    subst /mq' mr'/. reduce //.
    rewrite /-> rotate_mem 1 k/. reduce //.
    rewrite /-> nmatch_correct/. reduce //.
    split >>> [idtac, reflexivity].
    rewrite /-> lappend_correct, -> mem_append_correct/.
    reduce //.
    reflexivity.
  }
  {
    so /mod_lt_r n (succ k)/ /r_leq'/.
    unfold /lt in r_leq'/.
    so /leq_succ_invert _ _ r_leq'/ /r_leq/.
    so /lt_from_leq_neq _ _ r_leq r_neq/ /r_lt/. clear /r_leq' r_leq r_neq/.
    assert /mod (succ n) (succ k) = succ (mod n (succ k)) : nat/ /h_rem_succ/ >>>
    [
      rewrite /succ n = 1 + n : nat, -> plus_commute, -> mod_plus_alt, -> plus_commute, -> mod_operands_lt _ _ __/ >>
      omega,
      idtac
    ].
    assert /div (succ n) (succ k) = div n (succ k) : nat/ /h_div_succ/.
    {
      apply /leq_antisymm/ >>
      (apply /times_cancel_leq_r _# 2 (succ k) __/ >>> [omega, idtac] >> rewrite /-> div_prop' at all/ >> omega).
    }
    rewrite /-> h_div_succ at all, -> h_rem_succ, -> minus_succ/.
    clear /h_div_succ h_rem_succ/.
    rewrite /-> minus_succ_l_eq _# 2 in ih/ >>> [omega, reduce /ih/].
    assert /0 < k - mod n (succ k)/ /r_lt'/ >>> [omega, idtac].
    so /succ_pred _ r_lt'/ /not_full/. clear /r_lt'/.
    revert /ih/. remember /term_sem _ _ (make_dnat n)/ /_/ /rec_val/ /rec_val_eq/.
    destruct /rec_val/ /mq' mr'/. reduce //.
    intro /(mq'_eq mr'_eq)/.
    unfold /mem_div_helper/. reduce //.
    unfold /mem_div_helper in rec_val_eq/. reduce /rec_val_eq/.
    unfold /nrec, nrec in rec_val_eq/. reduce /concl rec_val_eq/.
    rewrite /<- rec_val_eq/. reduce //. clear /rec_val_eq/.
    subst /mq' mr'/. reduce //.
    rewrite /<- not_full at 0/.
    rewrite /-> rotate_remainder (pred (k - mod n (succ k))) k __/ >>> [omega, idtac].
    reduce //. rewrite /-> nmatch_correct/. reduce //.
    rewrite /<- not_full at 1 0/. reduce //.
    split >> reflexivity.
  }
}
qed ();


define /mem_div k/
/
  lam
  (
    letp all_left (app all_right (mem_div_helper k) var)
    (pair (right all_left) var (app all_right (mem_to_dnat (succ k)) var))
  )
//
  forall (k : nat) . term nil (arrow dnat (tensor (mem (succ k)) dnat))
/;
withTypecheck (unfold /mem_div/). qed ();


lemma "mem_div_correct"
/
  forall (n k : nat) .
  let (q, r) = divmod n (succ k) in
 (`term_sem _ (arrow _ _) (mem_div k) env_nil) (make_dnat n) = (make_mem q (succ k), make_dnat r) : 
 (tp_sem (mem (succ k)) & tp_sem dnat)
/;
intro /n k/. inference.
assert /succ k : pos/ /k_pos/ >>> [unfold /pos/ >> splitOf >>> [typecheck, omega], idtac].
unfold /mem_div/.
reduce //.
so /mem_div_helper_correct n k/ /helper_correct/.
revert /helper_correct/.
generalize /term_sem (mem_div_helper k) _# 2/ /_/ /tmp/. destruct /tmp/ /mr mq/. reduce //.
rewrite /-> divmod_equal at all/.
reduce //.
intro /(mq_eq mr_eq)/. subst /mq mr/.
extensionality >>> [reflexivity, reduce //].
so /remainder_to_dnat (succ k - mod n (succ k)) (succ k) __/ /tmp/ >>>
[omega, reduce /tmp/ >> rewrite /-> tmp/ >> clear /tmp/].
compat.
so /mod_lt_r n (succ k)/ /h_mod/.
omega.
qed ();



(* INVERSE DIVISION *)

define /mem_div_inverse k/
/
  lam
  (letp all_left var (app (left all_right) (app all_right (lappend _) (app all_right (mem_to_dnat (succ k)) var)) var))
//
  forall (k : nat) . term nil (arrow (tensor (mem (succ k)) dnat) dnat)
/;
withTypecheck (unfold /mem_div_inverse/). qed ();


lemma "mem_div_inverse_correct"
/
  forall (n k : nat).
  (`term_sem _ (arrow _ _) (mem_div_inverse k) env_nil)
  ((`term_sem _ (arrow _ _) (mem_div k) env_nil) (make_dnat n)) = make_dnat n : tp_sem dnat
/;
intro /n k/. inference.
assert /succ k : pos/ /k_pos/ >>> [unfold /pos/ >> splitOf >>> [typecheck, omega], idtac].
so /mem_div_correct n k/ /h/. revert /h/.
rewrite /-> divmod_equal/. reduce //.
intro /h_mem_div/.
rewrite /-> h_mem_div/. clear /h_mem_div/.
unfold /mem_div_inverse/. reduce //.
rewrite /-> lappend_correct at all/.
rewrite /-> mem_to_dnat_correct/.
assert /forall (a b : nat) . append (make_dnat a) (make_dnat b) = make_dnat (a + b) : _/ /lem/.
{
  clear /n k k_pos/.
  intro /a b/. induction /a/ >> auto.
}
repeatn 2 (rewrite /-> lem/).
rewrite /-> times_commute, <- times_dist_succ_r, -> div_prop/.
reflexivity.
qed ();



endModule ();